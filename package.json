{
  "name": "stone-grass-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "dev:db": "docker compose up -d",
    "dev:db:down": "docker compose down",
    "dev:db:logs": "docker compose logs -f postgres",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n vite,api,db -c green,cyan,magenta \"pnpm dev\" \"pnpm dev:api\" \"pnpm dev:db\"",
    "build": "tsc -p tsconfig.json && vite build",
    "build:server": "tsc -p tsconfig.server.build.json",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0",
    "tone": "^15.1.22",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.2",
    "typescript": "^5.3.0",
    "vite": "^5.1.0"
  }
}
